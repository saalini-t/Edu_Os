# Copy to .env and fill in. NEVER commit .env.
# - Docker Compose reads this file from the repo root (POSTGRES_PASSWORD, JWT_SECRET, ...).
# - Running the backend directly: copy to backend/.env and set DATABASE_URL.
POSTGRES_PASSWORD=
SEED_ON_START=true
APP_ENV=development                      # development | test | production
DATABASE_URL=postgresql+psycopg2://eduos:CHANGE_ME@localhost:5432/eduos
# Required, >= 32 chars. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_MINUTES=60
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=200
CHUNK_WORDS=120
CHUNK_OVERLAP_WORDS=20
CORS_ORIGINS=http://localhost:5173

# Language model. 'fake' = deterministic offline demo (no model). 'ollama' = local model, no paid key needed:
#   ollama pull qwen2.5:3b ; LLM_PROVIDER=ollama ; LLM_MODEL=qwen2.5:3b
# From Docker on Windows/macOS the host's Ollama is http://host.docker.internal:11434 (loopback/private hosts only,
# unless LLM_ALLOW_EXTERNAL=true -- never send real student data to an external service).
LLM_PROVIDER=fake
# LLM_MODEL=qwen2.5:3b
# LLM_BASE_URL=http://host.docker.internal:11434
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=1

# Retrieval (Phase 2): hybrid = full-text + pgvector with RRF. Falls back to full-text only, visibly, when
# EMBEDDING_PROVIDER=none, pgvector is missing, no model is active, or the configured model differs from the active one.
RETRIEVAL_MODE=hybrid
EMBEDDING_PROVIDER=none                  # none | sentence_transformers (needs requirements-embeddings.txt; local, offline after first download)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_ALLOW_DOWNLOAD=true            # downloads PUBLIC model weights once; no student data leaves the machine
# After changing EMBEDDING_MODEL run: python -m app.knowledge.reindex --activate

# Policy thresholds: development-selected on a tiny labelled set (see eval/THRESHOLDS.md); NOT validated values
T_CLARIFY=0.5
RET_MIN_CHUNKS=1
RET_MIN_TERMS=4                          # dev-selected (eval/THRESHOLDS.md)
# RET_MIN_SIM is specific to the embedding model below (cosine scale differs per model). 0.6 was dev-selected for
# all-MiniLM-L6-v2 only; leave it unset (lexical support only) for any other model until it has been re-swept.
RET_MIN_SIM=0.6
T_MASTER=0.8
N_MIN=3
MAX_ACTIONS=6
MAX_CLARIFY_ROUNDS=2
MAX_EXPLAIN_ATTEMPTS=2
MAX_PRACTICE_SETS=2

# Demo seeding (refused when APP_ENV=production)
SEED_DEMO_PASSWORD=eduos-demo-2026
